{
  "name": "credroute",
  "version": "1.0.0",
  "private": true,
  "description": "CredRoute - an experimental digital lending marketplace and credit decision engine.",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node server/index.js",
    "dev:api": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --app-dir backend",
    "start": "npm run build && NODE_ENV=production node server/index.js",
    "worker": "node server/worker.js",
    "build": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js",
    "seed": "node data/seed.js",
    "ml:setup": "pip install -r ml/requirements.txt && python3 ml/train_models.py --dataset indian",
    "ml:train": "python3 ml/train_models.py --dataset indian",
    "ml:train:us": "python3 ml/train_models.py --dataset us",
    "ml:indian": "python3 ml/generate_indian_dataset.py && python3 ml/train_models.py --dataset indian",
    "ml:install": "pip install -r ml/requirements.txt",
    "ml:finbert": "pip install -r ml/requirements-finbert.txt || echo 'FinBERT extras skipped — keyword fallback will be used.'",
    "migrate": "cd backend && alembic upgrade head",
    "test": "node --test server/tests/*.test.js",
    "test:api": "PYTHONPATH=backend python3 backend/scripts/run_tests.py",
    "bench": "PYTHONPATH=backend python3 backend/benchmarks/run_proof.py --mode quick",
    "bench:full": "PYTHONPATH=backend python3 backend/benchmarks/run_proof.py --mode full",
    "scale:data": "PYTHONPATH=backend python3 backend/scripts/generate_scale_data.py --mode full",
    "load": "locust -f backend/tests/load/locustfile.py --host http://127.0.0.1:8000"
  },
  "dependencies": {
    "bullmq": "^5.58.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "mongoose": "^8.18.0",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3"
  }
}
