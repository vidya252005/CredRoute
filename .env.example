PORT=5000
USE_FASTAPI=true
FASTAPI_URL=http://127.0.0.1:8000
# If the Express gateway also runs in Docker Compose, use:
# FASTAPI_URL=http://api:8000

# FastAPI backend
DATABASE_URL=postgresql+psycopg2://credroute:credroute@127.0.0.1:5432/credroute
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
STACKING_ENABLED=true

# Legacy Node backend (set USE_FASTAPI=false to enable)
MONGODB_URI=mongodb://127.0.0.1:27017/credroute
NODE_ENV=development
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SEC=60
LENDER_TIMEOUT_MS=3000
